# KAI Scheduler 101 launchable configuration.
# Brev injects these through Launchable environment configuration; scripts/brev-setup.sh
# captures them into .env. For local testing, copy this file to .env.

# Cluster
K3S_CHANNEL=v1.34
# Optional exact k3s version. Leave empty to use K3S_CHANNEL.
K3S_VERSION=

# Workshop site
WORKSHOP_PORT=3000
LAB_MAX_SESSIONS=25
DEPLOY_WORKSHOP=true

# Pinned lab component versions
KAI_VERSION=v0.16.5
# OCI Helm chart version. A leading "v" is accepted and normalized by Ansible.
FAKE_GPU_OPERATOR_VERSION=0.2.0
KWOK_VERSION=v0.7.0
GROVE_VERSION=v0.1.0-alpha.11
GROVE_NAMESPACE=grove-system
# Optional exact kube-prometheus-stack chart version. Leave empty for the chart repo default.
KUBE_PROMETHEUS_STACK_VERSION=
MONITORING_NAMESPACE=monitoring
