# KAI Scheduler 101 launchable configuration.
# Brev injects these through Launchable environment configuration; scripts/brev-setup.sh
# captures them into .env. For local testing, copy this file to .env.

# Cluster
KIND_NODE_IMAGE=kindest/node:v1.34.0
CLUSTER_NAME=kai-scheduler-101

# Workshop site
WORKSHOP_PORT=3000
LAB_MAX_SESSIONS=25
DEPLOY_WORKSHOP=true

# Pinned lab component versions
KAI_VERSION=v0.16.5
FAKE_GPU_OPERATOR_VERSION=0.2.0
KWOK_VERSION=v0.7.0
